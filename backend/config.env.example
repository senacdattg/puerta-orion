# Configuración del entorno para Puerta Orion

# Configuración básica de Flask
SECRET_KEY=tu-clave-secreta-muy-segura-aqui
DEBUG=true

# Configuración del servidor
HOST=0.0.0.0
PORT=5000

# Configuración de la base de datos
DATABASE_URL=mysql+mysqlconnector://usuario:contraseña@localhost/puerta_orion

# Configuración de CORS (puertos del frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# Configuración de JWT
JWT_SECRET_KEY=tu-jwt-secret-key-muy-segura
JWT_ACCESS_TOKEN_EXPIRES=1800  # 30 minutos

# Configuración de email (opcional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-password-de-aplicacion

# Configuración de APIs externas (opcional)
API_KEY=tu-api-key
API_URL=https://api.externa.com

# Configuración de logs
LOG_LEVEL=DEBUG
LOG_DIR=logs
LOG_FILE=logs/app/app.log
LOG_ERROR_FILE=logs/app/error.log
LOG_ACCESS_FILE=logs/app/access.log
LOG_DB_FILE=logs/database/db.log
LOG_ARCHIVE_DIR=logs/archive

# Entorno de Flask
FLASK_ENV=development

