{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "types": [],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.js", "src/**/*.vue", "src/**/*.jsx"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-ssr",
    "**/@types",
    "**/winjs",
    "**/AppData",
    "**/Microsoft",
    "**/TypeScript"
  ]
}
