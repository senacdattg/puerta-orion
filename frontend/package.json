{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run --reporter=verbose --reporter=junit --outputFile=./coverage/test-results.xml",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage --reporter=verbose --reporter=junit --outputFile=./coverage/test-results.xml"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@mercadopago/sdk-js": "^0.0.3",
    "axios": "^1.12.2",
    "bootstrap": "^5.3.7",
    "install": "^0.13.0",
    "npm": "^11.5.2",
    "pinia": "^3.0.3",
    "sweetalert2": "^11.14.5",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "globals": "^16.3.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.12",
    "vite": "^7.0.6",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^4.0.14"
  }
}
